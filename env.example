# Copy to .env (cp env.example .env) and fill in. .env is gitignored - never commit real values.

# Claude on AWS Bedrock (Anthropic Messages API via the Bedrock Mantle endpoint)
LLM_REGION=eu-north-1
LLM_API_KEY=
LLM_MODEL=anthropic.claude-sonnet-5

# Hugging Face (optional, dataset pulls)
HF_TOKEN=

# App
HOSPITAL_PROFILE=urban_500
# en_core_web_lg is the default; the free-tier deploy uses en_core_web_sm to fit 512 MB
SPACY_MODEL=en_core_web_lg
