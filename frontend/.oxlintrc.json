{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y"],
  // The console's form controls are design-system components that render the
  // native element underneath. Without this the accessibility rules stop
  // seeing them entirely, so a <label> wrapping an <Input> reads as a label
  // wrapping nothing. Naming them keeps every a11y rule working on them
  // rather than turning one rule off.
  "settings": {
    "jsx-a11y": {
      "components": {
        "Input": "input",
        "Select": "select",
        "Textarea": "textarea",
        "Btn": "button"
      }
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // The rule wants <hr> for role="separator" and <output> for role="status".
    // A resize handle has to take focus, which <hr> cannot, and role="status"
    // on a div is the live region pattern <output> was never meant to replace.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      // Fast refresh is a browser concern. Test files and their helpers are
      // never hot-reloaded, so mixing a render helper with fixtures in one
      // file costs nothing there.
      "files": ["**/*.test.{js,jsx}", "src/test/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
